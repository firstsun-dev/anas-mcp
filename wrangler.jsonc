{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anas-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // `workers.dev` and Version/Preview URLs are a separate ingress path that does not go through the
  // Cloudflare Access application protecting the custom domain (Access is attached to the zone/hostname, not to
  // the Worker itself). Verified against current Wrangler docs (workers.dev / preview_urls config reference,
  // 2026-10): leaving either enabled would let a client reach `/mcp` without an Access-issued
  // `Cf-Access-Jwt-Assertion`, bypassing the dual OAuth/Service-Token gate entirely. Both are explicitly disabled
  // so the only reachable ingress is the custom domain that infra-config attaches to the Access application.
  "workers_dev": false,
  "preview_urls": false,
  // Read-only PostgreSQL access (Windmill-ingested blog_analytics data). The database credential is owned by
  // the Hyperdrive configuration and must never be copied into this file or Secrets Store.
  // Local dev: set WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_ANALYTICS_DB to a local Postgres URL.
  "hyperdrive": [
    {
      "binding": "ANALYTICS_DB",
      "id": "8677c23af5c14b43a460169f2f2cc93f"
    }
  ],
  // Cloudflare Access origin validation (non-secret identifiers; the Access application is Terraform-managed in
  // firstsun-dev/infra-config). The Worker fails closed (503 on /mcp) until BOTH values are set. Fill them from
  // the infra-config outputs `anas_mcp_access_team_domain` / `anas_mcp_access_aud` as part of the coordinated
  // rollout (see docs/cloudflare-access.md). These are not credentials; never put secrets in `vars`.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "firstsun.cloudflareaccess.com",
    "ACCESS_AUD": "1041a0fe23797ad6035a58c1f501544d853c8098bd5165c6b9c89174cad55327",
    // Approved Microsoft Clarity project_key allowlist (identifier, not a credential); must equal the Windmill variable
    // f/blog_analytics/clarity_project_key. Comma-separated for several projects. See docs/clarity.md.
    "CLARITY_PROJECT_KEYS": "wrddojsfjm",
    // Approved GA4 numeric property IDs (identifiers, not credentials). With several IDs every GA4 tool call must pass
    // `propertyId`. GA4 stays disabled until the GOOGLE_OAUTH_CREDENTIALS Secrets Store binding is also added. See docs/ga4.md.
    "GA4_PROPERTY_IDS": "346676362,269121931"
  }
}
